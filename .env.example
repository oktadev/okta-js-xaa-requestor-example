# Environment Configuration

## Required Variables
IDP_URL=https://idp.xaa.dev
AUTH_SERVER_URL=https://auth.resource.xaa.dev
TODO_RESOURCE_SERVER=https://api.resource.xaa.dev
# REDIRECT_URI is auto-detected from the incoming request's protocol/host (works out of the box in Codespaces).
# Only set this to override that behavior.
# REDIRECT_URI=https://<codespace-name>-3000.app.github.dev/auth/callback

CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
RESOURCE_CLIENT_ID=your-resource-client-id
RESOURCE_CLIENT_SECRET=your-resource-client-secret

## Security - CRITICAL: Must be set to a random secret in production
SESSION_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION

## Optional
NODE_ENV=development


